# WebSocket URL for the shared 24/7 match-state server (see server/README.md).
# Leave blank to use the local-only simulated server (today's default behavior).
# Example once deployed: VITE_WS_URL=wss://your-app.example.com
VITE_WS_URL=

# Authoritative movement/combat WebSocket. In production this can be the same
# HTTPS origin that serves the game (for example wss://kryx.live).
VITE_AUTH_WS_URL=
